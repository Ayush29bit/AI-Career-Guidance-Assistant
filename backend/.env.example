# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
#   cp backend/.env.example backend/.env
#
# DATABASE_URL uses the psycopg (v3) driver, so the scheme must be
# postgresql+psycopg -- not plain postgresql, which selects psycopg2.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/career_counsellor

# Echo every SQL statement to stdout. Useful while debugging, noisy otherwise.
DB_ECHO=false

# --------------------------------------------------------------------------
# LLM
# --------------------------------------------------------------------------
# The conversational layer, backed by the Gemini Developer API. Get a key at
# https://aistudio.google.com/apikey -- the free tier is enough for development.
#
# Leave LLM_API_KEY unset and the API still runs: messages are stored, the
# profile and recommendation endpoints work, and the chat endpoint returns a
# clearly-marked fallback instead of a counsellor reply.
LLM_API_KEY=
# Provider model id. Never hardcoded in application code.
# gemini-3.5-flash answers a turn in roughly half the time of gemini-3.6-flash,
# which matters because each turn makes two calls. Both are current and both
# handle the structured extraction; swap freely, no code change needed.
#
# Free-tier quota is counted per model per day (gemini-3.6-flash allows 20
# requests/day, i.e. 10 conversation turns), so switching models also switches
# to a separate quota bucket.
LLM_MODEL=gemini-3.5-flash
# Seconds to wait for one provider call before giving up and falling back.
LLM_TIMEOUT_SECONDS=45
